.m2/

# Local data and working dirs (not committed)
/kaggle/data/
/fb-cover/
/video/

# one-off RUO PDF/XLSX parsing scripts, one working dir per region (tmp-ruo-plovdiv/, tmp-ruo-2026/, …)
/tmp-ruo-*/

# one-off RUO responses/attachments dump (not part of the build)
/tmp-all-ruo/

# one-off RUO school-name → code fuzzy-matching script
/scratch_mapping_v2/
