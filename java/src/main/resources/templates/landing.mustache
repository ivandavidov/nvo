<!DOCTYPE html>
<html lang="bg">
<head>
  <meta charset="utf-8">
  <title>{{title}}</title>
  <meta name="description" content="{{description}}">
  <meta name="author" content="Иван Давидов">
{{{head}}}
  <link rel="canonical" href="{{canonical}}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{canonical}}">
  <meta property="og:title" content="{{title}}">
  <meta property="og:description" content="{{description}}">
  <meta property="og:image" content="{{siteUrl}}images/social-preview.png">
  <meta property="og:locale" content="bg_BG">
  <meta property="og:site_name" content="НВО и ДЗИ - Иван Давидов">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{title}}">
  <meta name="twitter:description" content="{{description}}">
  <meta name="twitter:image" content="{{siteUrl}}images/social-preview.png">
  <script type="application/ld+json">{{{jsonLd}}}</script>
  <script type="module" src="../../js/pages/landing.js"></script>
</head>
<body data-grade="{{grade}}"{{#isCity}} data-city="{{citySlug}}"{{/isCity}}>
{{{header}}}

  <main id="main" class="container page landing">
    <nav class="breadcrumbs" aria-label="Път">
      <ol>
        <li><a href="../../">Начало</a></li>
        <li><a href="../">{{gradeTitle}}</a></li>
        <li><span aria-current="page">{{crumb}}</span></li>
      </ol>
    </nav>

    <header class="page-head">
      <p class="page-head__eyebrow">{{#icon}}trophy{{/icon}} {{eyebrow}}</p>
      <h1 class="page-head__title">{{h1}}</h1>
      <h2 class="landing__subtitle">{{h2}}</h2>
      <p class="page-head__lead">{{methodology}}</p>
      <div class="page-head__actions cluster">
{{#isCity}}
        <a class="btn btn--primary" href="../#{{citySlug}}">{{#icon}}chart{{/icon}} <span class="chip__long">Сравни в графиката</span><span class="chip__short">Сравни</span></a>
        <a class="btn" href="../{{year}}/">{{#icon}}trophy{{/icon}} <span class="chip__long">Национална класация {{year}}</span><span class="chip__short">Класация<span class="page-head__year"> {{year}}</span></span></a>
{{#hasBalove}}
        <a class="btn" href="../balove/{{citySlug}}/">{{#icon}}target{{/icon}} <span class="chip__long">Балове {{inCity}}</span><span class="chip__short">Балове</span></a>
{{/hasBalove}}
{{/isCity}}
{{#isYear}}
        <a class="btn btn--primary" href="../">{{#icon}}chart{{/icon}} <span class="chip__long">Сравни училищата</span><span class="chip__short">Сравни</span></a>
        <a class="btn" href="../../stats/?grade={{grade}}">{{#icon}}pie{{/icon}} <span class="chip__long">Статистика за {{grade}} клас</span><span class="chip__short">Статистика</span></a>
{{/isYear}}
      </div>
    </header>

{{#noExam}}
    <div class="banner" role="note">{{#icon}}info{{/icon}}<span>{{noExam}}</span><a class="banner__action" href="../{{noExamSource}}/">Класация {{noExamSource}} →</a></div>
{{/noExam}}
{{#isYear}}
    <nav class="cluster landing__years" aria-label="Години">
      <span class="muted text-sm">Години:</span>
{{#years}}
      <a class="chip" href="../{{value}}/"{{#current}} aria-current="page"{{/current}}>{{value}}</a>
{{/years}}
    </nav>
{{/isYear}}

    <section class="card landing__card" aria-label="Класация">
      <div class="card__head">
        <div class="cluster landing__filters">
          <div class="input-icon">
            {{#icon}}search{{/icon}}
            <input class="input" type="search" data-filter placeholder="Търси училище{{#showCity}} или град{{/showCity}}…" aria-label="Търси в таблицата">
          </div>
{{#showCity}}
          <select class="select" data-city-filter aria-label="Град">
            <option value="">Всички градове</option>
          </select>
{{/showCity}}
        </div>
        <p class="muted text-sm" data-count>{{count}} училища</p>
{{#hasTypes}}
        <div class="type-filter" role="group" aria-label="Покажи само училищата от избраните видове" data-n="{{typeCount}}">
          <span class="type-filter__label" aria-hidden="true">Покажи само</span>
{{#types}}
          <button type="button" class="chip type-chip" data-school-type="{{key}}" aria-pressed="false"><span class="type-badge type-badge--{{key}}" aria-hidden="true">{{letter}}</span><span class="type-chip__name">{{plural}}</span><span class="type-chip__count"><span class="sr-only">, </span><span data-type-count>{{count}}</span></span></button>
{{/types}}
        </div>
{{/hasTypes}}
      </div>
      <div class="table-wrap table-wrap--tall landing__table">
        <table class="data-table" data-sortable>
          <thead>
            <tr>
              <th class="num" data-type="num" aria-sort="ascending"><button type="button" class="th-sort">#{{#icon}}sort{{/icon}}</button></th>
              <th data-type="text" aria-sort="none"><button type="button" class="th-sort">Училище{{#icon}}sort{{/icon}}</button></th>
{{#showCity}}
              <th data-type="text" aria-sort="none"><button type="button" class="th-sort">Град{{#icon}}sort{{/icon}}</button></th>
{{/showCity}}
              <th class="center" data-type="num" data-first="ascending" aria-sort="none" title="Държавно (Д), общинско (О), частно (Ч) или духовно (ДУ) и място сред училищата от същия вид в класацията"><button type="button" class="th-sort">Тип / №{{#icon}}sort{{/icon}}</button></th>
              <th class="num" data-type="num" aria-sort="none"><button type="button" class="th-sort">{{belLabel}}{{#icon}}sort{{/icon}}</button></th>
              <th class="num" data-type="num" aria-sort="none"><button type="button" class="th-sort">{{matLabel}}{{#icon}}sort{{/icon}}</button></th>
              <th class="num" data-type="num" aria-sort="none"><button type="button" class="th-sort">Общо{{#icon}}sort{{/icon}}</button></th>
            </tr>
          </thead>
          <tbody>
{{#rows}}
            <tr data-school-type="{{typeKey}}"><td class="num muted">{{rank}}</td><td><a href="../../school/{{code}}/">{{name}}</a></td>{{#showCity}}<td>{{city}}</td>{{/showCity}}<td class="center nowrap" data-sort="{{typeSort}}"><span class="type-no"><span class="type-badge type-badge--{{typeKey}}" title="{{typeLabel}}"><span aria-hidden="true">{{typeLetter}}</span><span class="sr-only">{{typeLower}}</span></span><span class="type-no__n">{{typeNo}}</span></span></td><td class="num">{{bel}}</td><td class="num">{{mat}}</td><td class="num"><strong>{{total}}</strong></td></tr>
{{/rows}}
          </tbody>
        </table>
      </div>
    </section>
  </main>

{{{footer}}}
</body>
</html>
